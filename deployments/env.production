#!/usr/bin/env python3
"""Create deployments/.env.production (gitignored, chmod 600) from .env.production.template,
filling matching keys from apps/api/.env (override: ./env.production /path/to/.env).
Never prints values. Local-only keys are NOT copied (they would break prod).
Re-running keeps values already present in .env.production."""
import os, re, secrets, sys

here = os.path.dirname(os.path.abspath(__file__))
src = sys.argv[1] if len(sys.argv) > 1 else os.path.join(here, "..", "apps", "api", ".env")
if not os.path.exists(src):  # worktrees don't carry the gitignored .env: look in the main checkout
    main = os.path.abspath(os.path.join(here, "..")).split("/.claude/worktrees/")[0]
    alt = os.path.join(main, "apps", "api", ".env")
    if os.path.exists(alt):
        src = alt
SKIP = {"MONGO_URL", "DB_NAME", "APP_URL", "CORS_ORIGINS", "PISTON_URL", "BACKEND_UPLOADS_DIR", "SEED_REPORT_DIR",
        "PIPER_BIN", "PIPER_VOICE_DIR", "PIPER_VOICE_MODEL", "DOMAIN", "SITE_ADDRESS"}
vals = {}
if os.path.exists(src):
    for line in open(src):
        m = re.match(r"\s*(?:export\s+)?([A-Z][A-Z0-9_]*)\s*=\s*(.*?)\s*$", line)
        if m:
            v = m.group(2)
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
            if v and m.group(1) not in SKIP:
                vals[m.group(1)] = v
else:
    print(f"warning: {src} not found; writing template defaults only", file=sys.stderr)
dst = os.path.join(here, ".env.production")
prev = {}
if os.path.exists(dst):
    for line in open(dst):
        m = re.match(r"([A-Z][A-Z0-9_]*)=(.+)$", line.strip())
        if m:
            prev[m.group(1)] = m.group(2)
out, filled, missing = [], 0, []
for line in open(os.path.join(here, ".env.production.template")):
    line = line.rstrip("\n")
    m = re.match(r"(# )?([A-Z][A-Z0-9_]*)=$", line)
    if m:
        k = m.group(2)
        v = prev.get(k) or vals.get(k)
        if k == "DOMAIN":
            v = v or "iema.ai"
        if k == "JWT_SECRET" and not v:
            v = secrets.token_urlsafe(48)
        if v:
            line = f"{k}={v}"
            filled += 1
        elif not m.group(1):
            missing.append(k)
    out.append(line)
fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write("\n".join(out) + "\n")
print(f"wrote {dst}: {filled} keys set; still blank (review): {', '.join(missing)}")
