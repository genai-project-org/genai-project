# IEMA production environment. Run ./env.production to prefill .env.production from apps/api/.env.
# 'KEY=' lines are blank on purpose (the app treats blank as unset).
# '# KEY=' lines are optional tunables with code defaults: only uncomment with a real value (blank numerics would break parsing).

# ======================================================================
# Deployment (read by compose/Caddy, not the app)
# ======================================================================
# Apex domain; APP_URL/CORS/web build URL derive from it. Blank = iema.ai. Use <ip>.sslip.io for pre-DNS testing.
DOMAIN=
# Caddy site list. Blank = 'iema.ai, www.iema.ai'. For sslip testing set it equal to DOMAIN.
SITE_ADDRESS=
# Let's Encrypt contact email
ACME_EMAIL=

# ======================================================================
# Core / URLs
# ======================================================================
# Leave blank: derived as https://$DOMAIN (OAuth redirect base)
APP_URL=
# Leave blank: derived as https://$DOMAIN,https://www.$DOMAIN
CORS_ORIGINS=
# Blank = bundled mongo container (mongodb://mongo:27017). Or an Atlas URI.
MONGO_URL=
# Blank = iema
DB_NAME=
# REQUIRED. long random string (env.production generates one)
JWT_SECRET=
# default 60
# JWT_ACCESS_MINUTES=
# default 30
# JWT_REFRESH_DAYS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# If set, admin mutations need X-Admin-Signature. Leave blank unless the admin UI signs.
ADMIN_HMAC_SECRET=
# encrypts stored connector tokens
MCP_TOKEN_ENCRYPTION_KEY=
# 1/true = connectors run in demo mode (no real provider calls)
MCP_DEMO_MODE=
# set by compose (/app/uploads)
# BACKEND_UPLOADS_DIR=
# default 100
# WELCOME_CREDITS=
# default 20
# DAILY_CREDITS=
# default 1
# CREDIT_COST_MESSAGE=
# default 15
# CREDIT_BUILDER_CREATE=
# default 8
# CREDIT_BUILDER_REFINE=

# ======================================================================
# LLM providers
# ======================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# default anthropic
# DEFAULT_AI_PROVIDER=
# DEFAULT_AI_MODEL=
# FALLBACK_AI_PROVIDER=
# FALLBACK_AI_MODEL=
# OPENAI_TEXT_MODEL=
# OPENAI_FALLBACK_MODEL=
# BUILDER_MODEL=
# BUILDER_DYNAMIC_MODEL=
# COUNSEL_MODEL=
# BUILDER_MAX_TOKENS=
# LLM_MAX_TOKENS=
# LLM_NONSTREAM_MAX_TOKENS=
# RESUME_MAX_TOKENS=
# CAREER_PIPELINE_MAX_TOKENS=

# ======================================================================
# Payments
# ======================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# FX fallback, default 85
# USD_TO_INR_RATE=
# default 1.02
# USD_TO_INR_PAD=
# seconds, default 43200
# USD_TO_INR_TTL=
# mobile IAP, optional
APPLE_APP_STORE_SHARED_SECRET=
# optional
REVENUECAT_WEBHOOK_AUTH=
# optional
GOOGLE_PLAY_SA_JSON=
# default com.iemaai.app
# GOOGLE_PLAY_PACKAGE=

# ======================================================================
# Email (Resend)
# ======================================================================
RESEND_API_KEY=
# verified sender on your Resend domain
SENDER_EMAIL=
# default IEMA.ai
# SENDER_NAME=

# ======================================================================
# AWS / S3 uploads (app keys, NOT infra)
# ======================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ======================================================================
# Code runner (Piston) - internal service
# ======================================================================
# Blank = http://piston:2000/api/v2 (bundled container)
PISTON_URL=
# default 15
# PISTON_TIMEOUT_S=
# default 5000
# PISTON_RUN_TIMEOUT_MS=

# ======================================================================
# Speech (optional, degrades gracefully)
# ======================================================================
# default small.en
# WHISPER_MODEL_SIZE=
# default cpu
# WHISPER_DEVICE=
# default int8
# WHISPER_COMPUTE_TYPE=
# PIPER_BIN=
# PIPER_VOICE_DIR=
